{
  "name": "iptv-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sass:build": "sass sass/index.scss src/app/global.css --no-source-map",
    "sass:watch": "sass sass/index.scss src/app/global.css --watch --no-source-map",
    "dev": "concurrently \"npm run sass:watch\" \"next dev\"",
    "build": "npm run sass:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx src/__tests__/i18n.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sass": "^1.96.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
